{
    "version": "0.2.0",
    "description": "Read-only viewer for text art, Markdown, code and patches",
    "homepage": "https://ansi.cat/",
    "license": "MIT|Apache-2.0",
    "notes": "ansi.cat is the default app for text art and PETSCII files, unless you selected a different app in the settings of Windows.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/doom-fish/ansicat-releases/releases/download/v0.2.0/ansi.cat-0.2.0-windows-x64.zip",
            "hash": "6ef71dccbc50649083af20d61679ceae7ea238443bec359e761e5751a2deeabf",
            "extract_dir": "ansi.cat-0.2.0-windows-x64"
        }
    },
    "bin": "ansicat.exe",
    "shortcuts": [
        [
            "ansi.cat.exe",
            "ansi.cat"
        ]
    ],
    "post_install": "Start-Process -FilePath \"$dir\\ansi.cat.exe\" -ArgumentList '--register' -Wait",
    "pre_uninstall": "Start-Process -FilePath \"$dir\\ansi.cat.exe\" -ArgumentList '--unregister' -Wait",
    "checkver": {
        "github": "https://github.com/doom-fish/ansicat-releases"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/doom-fish/ansicat-releases/releases/download/v$version/ansi.cat-$version-windows-x64.zip",
                "extract_dir": "ansi.cat-$version-windows-x64"
            }
        }
    }
}
